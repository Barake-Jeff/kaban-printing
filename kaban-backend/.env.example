# Variables marked (required) are checked at startup (src/config/env.validation.ts); the
# backend refuses to boot if one is missing or invalid. With NODE_ENV=production it also
# requires DB_PASSWORD and rejects MinIO's default minioadmin credentials.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# (required) Comma-separated list of allowed CORS origins (e.g. add your LAN IP to reach the app from another device)
FRONTEND_URL=http://localhost:3000
# Leave empty unless the API sits behind a reverse proxy / load balancer. Rate limiting keys
# anonymous callers by IP, so behind a proxy set the number of proxy hops (e.g. 1), or specific
# proxy addresses ("loopback", CIDRs). Never "true": it trusts a spoofable X-Forwarded-For.
TRUST_PROXY=

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# (required) DB_HOST, DB_PORT, DB_USERNAME, DB_NAME. DB_PASSWORD is required in production.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=kaban
# Read by the mysql container in docker-compose (not by the backend). Keep them equal to
# DB_PASSWORD / DB_NAME.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=kaban

# ── JWT ───────────────────────────────────────────────────────────────────────
# (required) At least 32 characters each, and the two must differ.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
# MINIO_ENDPOINT: used by the backend to reach MinIO (e.g. "minio" in Docker).
# MINIO_PUBLIC_*: optional overrides baked into presigned URLs opened by a
# browser — set these if the backend's own endpoint isn't browser-reachable
# (e.g. a Docker service name, or you're accessing from another device on
# your LAN and need your host's LAN IP here instead). Defaults to the
# MINIO_ENDPOINT/PORT/USE_SSL values above when unset.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_PORT=
MINIO_PUBLIC_USE_SSL=
# Region baked into presigned URLs. Leave empty for MinIO's default (us-east-1); only set it
# if you configured a custom region on the MinIO server, otherwise download links won't validate.
MINIO_REGION=
# (required) MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY, MINIO_BUCKET.
# minioadmin is only accepted outside production.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=printease
# Read by the minio container in docker-compose to create its root account. The backend's
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY must be valid credentials on that server.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── M-Pesa (Daraja) ───────────────────────────────────────────────────────────
# sandbox | production. Only "sandbox" turns the callback IP allowlist off (sandbox/ngrok
# callbacks don't come from Safaricom's production addresses); anything else enforces it.
MPESA_ENVIRONMENT=sandbox
# Secret path segment of the callback URL, at least 32 characters. Missing or shorter = every
# callback is refused. Daraja's CallBackURL must be <public base>/api/payments/mpesa/callback/<token>.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_TOKEN=
# Optional comma-separated override of the allowed callback source IPs. Leave empty to use
# Safaricom's published list (built into the backend). Set it if Safaricom announces new
# addresses — list the complete set, not just the additions.
MPESA_CALLBACK_IPS=
# Daraja app credentials. Not used yet: payments run on the stub until the integration is live.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# <public base>/api/payments/mpesa/callback/<MPESA_CALLBACK_TOKEN>
MPESA_CALLBACK_URL=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# (required) Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── SMS / WhatsApp ────────────────────────────────────────────────────────────
# Not used yet: notifications are stubbed until these integrations are live.
AT_USERNAME=sandbox
AT_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# ── Seed script (npm run seed, dev only — refuses to run with NODE_ENV=production) ──
# Passwords for the demo admin / customer. Leave empty to have random ones generated
# and printed once.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
