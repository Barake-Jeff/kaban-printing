# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed CORS origins (e.g. add your LAN IP to reach the app from another device)
FRONTEND_URL=http://localhost:3000

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=kaban

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
# MINIO_ENDPOINT: used by the backend to reach MinIO (e.g. "minio" in Docker).
# MINIO_PUBLIC_*: optional overrides baked into presigned URLs opened by a
# browser — set these if the backend's own endpoint isn't browser-reachable
# (e.g. a Docker service name, or you're accessing from another device on
# your LAN and need your host's LAN IP here instead). Defaults to the
# MINIO_ENDPOINT/PORT/USE_SSL values above when unset.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_PORT=
MINIO_PUBLIC_USE_SSL=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=printease

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
