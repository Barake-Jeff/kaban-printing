  "info": {
    "title": "PrintEase API",
    "description": "Generated from the code — do not edit by hand (`npm run openapi`).\n\nSuccessful responses are wrapped by `TransformInterceptor` as `{ statusCode, message, data }`;\nerrors are `{ statusCode, message, errors? }`. Each operation lists the guards that protect it.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Admin"
    },
    {
      "name": "AdminAuth"
    },
    {
      "name": "CustomerAuth"
    },
    {
      "name": "Files"
    },
    {
      "name": "Jobs"
    },
    {
      "name": "Notifications"
    },
    {
      "name": "Payments"
    },
    {
      "name": "Push"
    },
    {
      "name": "Users"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AdminLoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "phone",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "pattern": "/(?=.*[A-Za-z])(?=.*\\d)/"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "CreateJobDto": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string"
          },
          "fileName": {
            "type": "string",
            "maxLength": 500
          },
          "instructions": {
            "type": "string",
            "maxLength": 2000
          },
          "pages": {
            "type": "number",
            "minimum": 1
          },
          "copies": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000
          },
          "pageSelection": {
            "type": "string",
            "maxLength": 500
          },
          "colorMode": {
            "type": "string",
            "enum": [
              "bw",
              "color"
            ]
          },
          "sides": {
            "type": "string",
            "enum": [
              "single",
              "double"
            ]
          },
          "paperSize": {
            "type": "string",
            "maxLength": 20
          },
          "deliveryType": {
            "type": "string",
            "enum": [
              "pickup",
              "delivery"
            ]
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "mpesa",
              "pay_on_pickup"
            ]
          }
        },
        "required": [
          "pages",
          "copies",
          "colorMode",
          "sides",
          "paperSize",
          "deliveryType",
          "paymentMethod"
        ]
      },
      "CreateStaffDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "pattern": "/^(\\+254|0)[17]\\d{8}$/"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 100,
            "pattern": "/(?=.*[A-Za-z])(?=.*\\d)/"
          },
          "role": {
            "type": "object"
          }
        },
        "required": [
          "name",
          "phone",
          "password",
          "role"
        ]
      },
      "CustomerLoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "phone",
          "password"
        ]
      },
      "CustomerRegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "phone": {
            "type": "string",
            "pattern": "/^(\\+254|0)[17]\\d{8}$/"
          },
          "houseNumber": {
            "type": "string",
            "maxLength": 20
          },
          "estate": {
            "type": "string",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "pattern": "/(?=.*[A-Za-z])(?=.*\\d)/"
          }
        },
        "required": [
          "name",
          "phone",
          "houseNumber",
          "estate",
          "password"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "/^(\\+254|0)[17]\\d{8}$/"
          }
        },
        "required": [
          "phone"
        ]
      },
      "InitiateMpesaDto": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "pattern": "/^(\\+254|0)[17]\\d{8}$/"
          }
        },
        "required": [
          "jobId",
          "phone"
        ]
      },
      "PricingDto": {
        "type": "object",
        "properties": {
          "bwPerPage": {
            "type": "number",
            "minimum": 0
          },
          "colorPerPage": {
            "type": "number",
            "minimum": 0
          },
          "doubleSidedMultiplier": {
            "type": "number",
            "minimum": 0
          },
          "deliveryFee": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "bwPerPage",
          "colorPerPage",
          "doubleSidedMultiplier",
          "deliveryFee"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "SaveNotesDto": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "string",
            "maxLength": 5000
          }
        },
        "required": [
          "notes"
        ]
      },
      "SaveSettingsDto": {
        "type": "object",
        "properties": {
          "business": {
            "type": "object"
          },
          "pricing": {
            "$ref": "#/components/schemas/PricingDto"
          },
          "notificationMatrix": {
            "type": "object"
          }
        }
      },
      "SetUserPasswordDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "pattern": "/(?=.*[A-Za-z])(?=.*\\d)/"
          }
        },
        "required": [
          "newPassword"
        ]
      },
      "SubscribeDto": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "maxLength": 2048
          },
          "p256dh": {
            "type": "string",
            "maxLength": 255
          },
          "auth": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "endpoint",
          "p256dh",
          "auth"
        ]
      },
      "UpdateJobStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "printing",
              "ready",
              "delivered"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "UpdateNotifPrefsDto": {
        "type": "object",
        "properties": {
          "notifSms": {
            "type": "boolean"
          },
          "notifWhatsapp": {
            "type": "boolean"
          }
        },
        "required": [
          "notifSms",
          "notifWhatsapp"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "houseNumber": {
            "type": "string",
            "maxLength": 20
          },
          "estate": {
            "type": "string",
            "maxLength": 255
          }
        }
      }
    }
  }
